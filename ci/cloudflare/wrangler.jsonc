{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "v2khd-build-studio",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-14",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "app.lionhome.eu.org",
      "custom_domain": true
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "2026111401",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
