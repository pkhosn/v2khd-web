{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "v2khd-web",
  "main": "ci/cloudflare/worker.mjs",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "2026111401",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
